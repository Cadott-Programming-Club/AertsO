    "clsx": "^2.1.1",
    "eslint-config-next": "^16.4.2",
    "jsqr": "^1.4.0",
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
