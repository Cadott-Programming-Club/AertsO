# --- database ---
# local dev (sqlite): flip provider in prisma/schema.prisma to "sqlite" first
DATABASE_URL=file:./dev.db
# production (Supabase transaction pooler, best for serverless):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# direct pooler for the build-time schema push (optional — falls back to DATABASE_URL):
# DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- admins (comma-separated; these emails get the admin panel + printing) ---
ADMIN_EMAILS=you@example.com

# --- SMTP for email login codes (optional in dev; required for real games) ---
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
MAIL_FROM=AertsO <noreply@example.com>
