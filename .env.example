# --- database (Supabase Postgres) ---
# local push: postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# vercel runtime: use the transaction pooler below
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# --- admins (comma-separated; these emails get the admin panel) ---
ADMIN_EMAILS=you@example.com

# --- SMTP for email login codes (optional in dev; required for real games) ---
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
MAIL_FROM=AertsO <noreply@example.com>
