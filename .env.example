# --- database ---
# On Vercel with the official Supabase integration: nothing to set. The schema
# reads the integration-injected vars — POSTGRES_PRISMA_URL (runtime,
# transaction pooler) and POSTGRES_URL_NON_POOLING (build-time prisma db push).
# For a local postgres push, fill them in from Supabase -> Connect:
#   postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
POSTGRES_PRISMA_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# local dev (sqlite): flip provider in prisma/schema.prisma to "sqlite" first
# DATABASE_URL=file:./dev.db

# --- admins (comma-separated; these emails get the admin panel + printing) ---
ADMIN_EMAILS=you@example.com

# --- SMTP for email login codes (optional in dev; required for real games) ---
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
MAIL_FROM=AertsO <noreply@example.com>
